#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_sampler;
uniform sampler2D v_sampler;
uniform sampler2D solid_sampler;

layout(binding = 0, r32f) uniform image2D u_out;
layout(binding = 1, r32f) uniform image2D v_out;

uniform float u_dt;
uniform float u_gravity;
uniform float u_vorticityConfinement;
uniform vec2  u_res;
uniform float u_h;

// Compute scalar vorticity ω = ∂v/∂x - ∂u/∂y at cell p.
// p is clamped to the interior so that p±1 reads stay within the texture.
float computeOmega(ivec2 p) {
    ivec2 res = ivec2(u_res);
    p = clamp(p, ivec2(1), res - ivec2(2));

    float vR = texelFetch(v_sampler, p + ivec2(1,0), 0).r;
    float vL = texelFetch(v_sampler, p - ivec2(1,0), 0).r;
    float uU = texelFetch(u_sampler, p + ivec2(0,1), 0).r;
    float uD = texelFetch(u_sampler, p - ivec2(0,1), 0).r;
    return (vR - vL - (uU - uD)) / (2.0 * u_h);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy) + ivec2(1, 1);
    if (pos.x > int(u_res.x) - 2 || pos.y > int(u_res.y) - 2) return;

    float solid      = texelFetch(solid_sampler, pos,               0).r;
    float solidBelow = texelFetch(solid_sampler, pos - ivec2(0,1), 0).r;

    float u = texelFetch(u_sampler, pos, 0).r;
    float v = texelFetch(v_sampler, pos, 0).r;

    // --- Gravity (CPU parity) ---
    if (solid != 0.0 && solidBelow != 0.0) {
        v += u_gravity * u_dt;
    }

    // --- Vorticity confinement (Fedkiw et al. 2001) ---
    // Only apply in fluid cells
    if (solid != 0.0) {
        ivec2 res = ivec2(u_res);

        // Clamp outer sample points to interior, so computeOmega's internal
        // reads (which go one step further) always stay in [0, res-1].
        ivec2 pR = clamp(pos + ivec2(1,0), ivec2(1), res - ivec2(2));
        ivec2 pL = clamp(pos - ivec2(1,0), ivec2(1), res - ivec2(2));
        ivec2 pU = clamp(pos + ivec2(0,1), ivec2(1), res - ivec2(2));
        ivec2 pD = clamp(pos - ivec2(0,1), ivec2(1), res - ivec2(2));

        float omega  = computeOmega(pos);
        float omegaR = computeOmega(pR);
        float omegaL = computeOmega(pL);
        float omegaU = computeOmega(pU);
        float omegaD = computeOmega(pD);

        // ∇|ω| using central differences
        vec2 grad = vec2(abs(omegaR) - abs(omegaL),
                         abs(omegaU) - abs(omegaD)) / (2.0 * u_h);
        float mag = length(grad);

        if (mag > 1e-6) {
            vec2 N = grad / mag;                       // unit vector along ∇|ω|
            // N × ω  (in 2D: (N.y·ω, -N.x·ω))
            vec2 force = u_vorticityConfinement * u_h * vec2(N.y * omega, -N.x * omega);
            u += force.x * u_dt;
            v += force.y * u_dt;
        }
    }

    imageStore(u_out, pos, vec4(u, 0.0, 0.0, 0.0));
    imageStore(v_out, pos, vec4(v, 0.0, 0.0, 0.0));
}
