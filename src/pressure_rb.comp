#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_sampler;
uniform sampler2D v_sampler;
uniform sampler2D solid_sampler;

layout(binding = 0, r32f) uniform image2D p_inout;   // read + write

uniform float u_h;
uniform float u_density;
uniform float u_dt;
uniform float u_overRelaxation;
uniform vec2  u_res;
uniform int   u_pass;   // 0 = red, 1 = black

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy) + ivec2(1, 1);
    if (pos.x > int(u_res.x) - 2 || pos.y > int(u_res.y) - 2) return;

    // Only process cells of the current colour
    int color = (pos.x + pos.y) & 1;
    if (color != u_pass) return;

    float solid = texelFetch(solid_sampler, pos, 0).r;
    if (solid == 0.0) return;

    float sL = texelFetch(solid_sampler, pos - ivec2(1,0), 0).r;
    float sR = texelFetch(solid_sampler, pos + ivec2(1,0), 0).r;
    float sD = texelFetch(solid_sampler, pos - ivec2(0,1), 0).r;
    float sU = texelFetch(solid_sampler, pos + ivec2(0,1), 0).r;
    float sSum = sL + sR + sD + sU;
    if (sSum == 0.0) return;

    // Read pressures from image (in-place)
    float pC = imageLoad(p_inout, pos).r;
    float pL = imageLoad(p_inout, pos - ivec2(1,0)).r;
    float pR = imageLoad(p_inout, pos + ivec2(1,0)).r;
    float pD = imageLoad(p_inout, pos - ivec2(0,1)).r;
    float pU = imageLoad(p_inout, pos + ivec2(0,1)).r;

    // Divergence (velocity is fixed during the SOR loop)
    float uC = texelFetch(u_sampler, pos,              0).r;
    float uR = texelFetch(u_sampler, pos + ivec2(1,0), 0).r;
    float vC = texelFetch(v_sampler, pos,              0).r;
    float vU = texelFetch(v_sampler, pos + ivec2(0,1), 0).r;
    float div = (uR - uC) + (vU - vC);

    float cp = u_density * u_h / u_dt;
    float G  = cp * div;

    // Gauss-Seidel update (uses the most recent neighbour values)
    float pGS = (sL*pL + sR*pR + sD*pD + sU*pU - G) / sSum;

    // Over-relaxation
    float newP = (1.0 - u_overRelaxation) * pC + u_overRelaxation * pGS;

    imageStore(p_inout, pos, vec4(newP, 0.0, 0.0, 0.0));
}
