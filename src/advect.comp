#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_velSampler;
uniform sampler2D u_smokeSampler;

layout(binding = 0, rgba32f) uniform image2D u_velOut;
layout(binding = 1, r32f)    uniform image2D u_smokeOut;

uniform float u_dt;
uniform float u_h;
uniform vec2  u_res;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(u_res.x) || pos.y >= int(u_res.y)) return;

    // Texture coordinates for the current cell
    vec2 texCoord = vec2(pos) / u_res;
    vec2 vel = texture(u_velSampler, texCoord).rg;

    // Physical position
    vec2 phys = (vec2(pos) + 0.5) * u_h;
    vec2 prevPhys = phys - u_dt * vel;
    vec2 prevTexCoord = prevPhys / (u_res * u_h);

    // Sample at traced position (bilinear filtering via sampler)
    vec2 newVel = texture(u_velSampler, prevTexCoord).rg;
    float newSmoke = texture(u_smokeSampler, prevTexCoord).r;

    // Write outputs
    imageStore(u_velOut, pos, vec4(newVel, 0.0, 0.0));
    imageStore(u_smokeOut, pos, vec4(newSmoke, 0.0, 0.0, 0.0));
}
