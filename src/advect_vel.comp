#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_sampler;
uniform sampler2D v_sampler;
uniform sampler2D solid_sampler;

layout(binding = 0, r32f) uniform image2D u_out;
layout(binding = 1, r32f) uniform image2D v_out;

uniform float u_dt;
uniform float u_h;
uniform vec2  u_res;

// Bilinear sample at physical (x,y) with staggering offsets (dx,dy)
float sampleField(sampler2D tex, float x, float y, float dx, float dy) {
    float h  = u_h;
    float h1 = 1.0 / h;

    // Clamp to valid physical domain (matches CPU)
    x = max(min(x, u_res.x * h), h);
    y = max(min(y, u_res.y * h), h);

    float xc = (x - dx) * h1;
    float yc = (y - dy) * h1;

    int x0 = min(int(floor(xc)), int(u_res.x) - 1);
    float tx = xc - float(x0);
    int x1 = min(x0 + 1, int(u_res.x) - 1);

    int y0 = min(int(floor(yc)), int(u_res.y) - 1);
    float ty = yc - float(y0);
    int y1 = min(y0 + 1, int(u_res.y) - 1);

    float sx = 1.0 - tx;
    float sy = 1.0 - ty;

    float v00 = texelFetch(tex, ivec2(x0, y0), 0).r;
    float v10 = texelFetch(tex, ivec2(x1, y0), 0).r;
    float v01 = texelFetch(tex, ivec2(x0, y1), 0).r;
    float v11 = texelFetch(tex, ivec2(x1, y1), 0).r;

    return sx*sy*v00 + tx*sy*v10 + sx*ty*v01 + tx*ty*v11;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy) + ivec2(1, 1);
    int resX = int(u_res.x);
    int resY = int(u_res.y);

    float h  = u_h;
    float h2 = 0.5 * h;

    float uC = texelFetch(u_sampler, pos, 0).r;
    float vC = texelFetch(v_sampler, pos, 0).r;

    float sC = texelFetch(solid_sampler, pos,               0).r;
    float sL = texelFetch(solid_sampler, pos - ivec2(1,0),  0).r;
    float sD = texelFetch(solid_sampler, pos - ivec2(0,1),  0).r;

    float newU = uC;
    float newV = vC;

    // --- u-component advection ---
    if (sC != 0.0 && sL != 0.0 && pos.y < resY - 1) {
        // avgV(i,j) = (v[i-1,j] + v[i,j] + v[i-1,j+1] + v[i,j+1]) * 0.25
        float vL  = texelFetch(v_sampler, pos + ivec2(-1,0), 0).r;
        float vU  = texelFetch(v_sampler, pos + ivec2( 0,1), 0).r;
        float vLU = texelFetch(v_sampler, pos + ivec2(-1,1), 0).r;
        float avgV = (vL + vC + vLU + vU) * 0.25;

        // Source position of u[i,j]: (i*h, j*h + h/2)
        float x = float(pos.x) * h;
        float y = float(pos.y) * h + h2;

        // Backward trace
        x = x - u_dt * uC;
        y = y - u_dt * avgV;

        // Sample u (U_FIELD: dx=0, dy=h2)
        newU = sampleField(u_sampler, x, y, 0.0, h2);
    }

    // --- v-component advection ---
    if (sC != 0.0 && sD != 0.0 && pos.x < resX - 1) {
        // avgU(i,j) = (u[i,j-1] + u[i,j] + u[i+1,j-1] + u[i+1,j]) * 0.25
        float uD  = texelFetch(u_sampler, pos + ivec2(0,-1), 0).r;
        float uR  = texelFetch(u_sampler, pos + ivec2(1, 0), 0).r;
        float uRD = texelFetch(u_sampler, pos + ivec2(1,-1), 0).r;
        float avgU = (uD + uC + uRD + uR) * 0.25;

        // Source position of v[i,j]: (i*h + h/2, j*h)
        float x = float(pos.x) * h + h2;
        float y = float(pos.y) * h;

        // Backward trace
        x = x - u_dt * avgU;
        y = y - u_dt * vC;

        // Sample v (V_FIELD: dx=h2, dy=0)
        newV = sampleField(v_sampler, x, y, h2, 0.0);
    }

    imageStore(u_out, pos, vec4(newU, 0.0, 0.0, 0.0));
    imageStore(v_out, pos, vec4(newV, 0.0, 0.0, 0.0));
}
