#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_sampler;
uniform sampler2D v_sampler;
uniform sampler2D p_sampler;
uniform sampler2D solid_sampler;

layout(binding = 0, r32f) uniform image2D u_out;
layout(binding = 1, r32f) uniform image2D v_out;

uniform float u_h;
uniform float u_density;
uniform float u_dt;
uniform vec2  u_res;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy) + ivec2(1, 1);
    if (pos.x > int(u_res.x) - 2 || pos.y > int(u_res.y) - 2) return;
    float uC = texelFetch(u_sampler, pos, 0).r;
    float vC = texelFetch(v_sampler, pos, 0).r;

    float solid = texelFetch(solid_sampler, pos, 0).r;
    if (solid == 0.0) {
        imageStore(u_out, pos, vec4(uC));
        imageStore(v_out, pos, vec4(vC));
        return;
    }

    // Pressure at this cell and neighbours
    float pC = texelFetch(p_sampler, pos, 0).r;
    float pL = texelFetch(p_sampler, pos - ivec2(1,0), 0).r;
    float pR = texelFetch(p_sampler, pos + ivec2(1,0), 0).r;
    float pD = texelFetch(p_sampler, pos - ivec2(0,1), 0).r;
    float pU = texelFetch(p_sampler, pos + ivec2(0,1), 0).r;

    // Solid flags
    float sL = texelFetch(solid_sampler, pos - ivec2(1,0), 0).r;
    float sR = texelFetch(solid_sampler, pos + ivec2(1,0), 0).r;
    float sD = texelFetch(solid_sampler, pos - ivec2(0,1), 0).r;
    float sU = texelFetch(solid_sampler, pos + ivec2(0,1), 0).r;

    // Apply pressure gradient correction (matching CPU)
    // CPU: u[i,j] -= sL * pCorr where pCorr = -div/sSum * overRelaxation ... 
    // But after all iterations, the accumulated correction is exactly the pressure field.
    // The gradient formula is: u -= (dt / (density * h)) * (pR - pC)  [for u-face at i]
    float factor = u_dt / (u_density * u_h);
    float newU = uC - factor * (pC - pL) * sL;
    float newV = vC - factor * (pC - pD) * sD;

    imageStore(u_out, pos, vec4(newU));
    imageStore(v_out, pos, vec4(newV));
}
